+static bool duplicate_matches(const struct mp_reference_reader_job *job,
+                              const AVFormatContext *fmt, bool require_start)
+{
+    const struct mp_reference_track_spec *p = &job->spec;
+    if (fmt->iformat != p->format || fmt->flags != p->format_flags ||
+        fmt->nb_streams != p->num_streams ||
+        fmt->start_time != p->format_start_time || p->ff_index < 0 ||
+        p->ff_index >= fmt->nb_streams)
+        return false;
