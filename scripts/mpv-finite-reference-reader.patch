+bool mp_reference_reader_job_cancelled(const struct mp_reference_reader_job *job)
+{
+    return !job || mp_time_ns() >= job->deadline_ns ||
+        stream_reference_reader_cancelled(job->grant);
+}
+
+bool mp_reference_reader_job_publication_current(const struct mp_reference_reader_job *job)
+{
+    // Job/grant pointer was release-published by the validated request. These
+    // immutable fields outlive all renderer calls; decoded/result/deadline are
+    // intentionally not read on this off-owner persistent-lifetime path.
+    return job && stream_reference_reader_current(job->grant);
+}
