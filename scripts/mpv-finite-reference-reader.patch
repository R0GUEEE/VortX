+/* Native-only proposed finite reader. UNCOMPILED/UNRUN; no public mpv ABI. */
+#pragma once
+#include <stdbool.h>
+#include <stdint.h>
+
+struct demuxer;
+struct demux_reference_request;
+#define DEMUX_REFERENCE_MAX_PAIRS 1024
+struct demux_reference_pair { int64_t start_ms, end_ms; };
+struct demux_reference_result {
+    int64_t source_generation, response_generation;
+    uint64_t source_epoch;
+    unsigned demux_epoch;
+    int stream_index, demuxer_id, ff_index, av_stream_id, source_origin;
+    int format_kind; // 1 exact lavf Matroska/WebM; 2 exact lavf MOV/MP4
+    int codec_id, time_base_num, time_base_den;
+    double origin_seconds; // actual demux start + consumer timestamp offset
+    int64_t prefix_start_ms, prefix_end_ms;
+    uint64_t input_bytes;
+    unsigned packets_seen, num_pairs;
+    // Complete bounded sequential selected-track prefix through first observed
+    // PTS>=1080 (or admitted genuine entity EOF), not a whole-movie absence
+    // proof. Every observed backward PTS fails; unseen future packets are not
+    // claimed checked after the intentional early stop. Equal/overlap survive.
+    bool complete;
+    struct demux_reference_pair pairs[DEMUX_REFERENCE_MAX_PAIRS];
+};
+enum demux_reference_reader_status {
+    DEMUX_REFERENCE_READER_PENDING,
+    DEMUX_REFERENCE_READER_CAPTURED,
+    DEMUX_REFERENCE_READER_RUNNING,
+    DEMUX_REFERENCE_READER_DECODED,
+    DEMUX_REFERENCE_READER_REVALIDATING,
+    DEMUX_REFERENCE_READER_READY,
+    DEMUX_REFERENCE_READER_UNAVAILABLE,
+    DEMUX_REFERENCE_READER_CANCELLED,
+};
+
+// Consumer thread, live demux only: capture is queued to its actual owner.
+// index must name the sole actually selected text subtitle. Deadline is an
+// absolute mp_time_ns, >now and <=30s for ENTIRE capture/read/decode/revalidate.
+// No URL, headers, current AVIO, sh_stream, or demux lifetime is borrowed.
+struct demux_reference_request *demux_reference_reader_request(
+    struct demuxer *demuxer, int stream_index, int64_t deadline_ns);
+enum demux_reference_reader_status demux_reference_reader_status(
+    struct demux_reference_request *request);
+
+// Exactly one utility worker, synchronously. Caller retains its request for
+// this entire call; cancel may be concurrent, release/run/revalidate/take may
+// NOT. The owner must JOIN that worker before queuing revalidation or releasing
+// the consumer reference. No new thread is hidden inside this API. Every new
+// FF context and decoder closes before return, including failure/cancellation.
+bool demux_reference_reader_run(struct demux_reference_request *request);
+
+// Original consumer, AFTER worker joined. Enqueue final source/response/peer/
+// selected-track/format/origin revalidation on SAME actual demux owner queue.
+// Different demuxes, seek/track ABA, teardown/expiry, or busy slot refuse.
+// After the one-time timing take, keep the request retained: the same grant may
+// be revalidated again from READY before later native prepare/commit admission.
+// Revalidation never renews its deadline/epoch or permits a second timing take.
+bool demux_reference_reader_revalidate(
+    struct demuxer *demuxer, struct demux_reference_request *request);
+
+// One-time immutable value copy only after owner revalidation. out must be
+// zero initialized. Result has no text/packet/URL/header/descriptor/pointer.
+// Caller MUST still perform existing core owner/load/intent/account admission;
+// this native result grants no publication authority. After any cancel/seek/
+// track/close/expiry status/take fails, including after READY. Use the original
+// demux_reference_request_cancel/release APIs; initial_request_take rejects
+// every request created by this API regardless of phase.
+// A successful take consumes only its copy permission; READY retains the grant
+// for the repeated owner revalidation above. Cancellation/status remain live.
+bool demux_reference_reader_take(
+    struct demux_reference_request *request, struct demux_reference_result *out);
+
+// Nonblocking off-owner predicate for an ALREADY validated+taken publication.
+// Checks only atomic independent cancel, retained demux epoch/retired state,
+// owned original-source sticky cancel/epoch/retired state, and genuine FF
+// response-lifetime token. It never reads AVIO, mutable job/result/phase fields,
+// or the preparation deadline. Active rendering therefore does not expire at
+// 30s. Capture/read/query/prepare/commit remain deadline-bound via old APIs.
+// Keep request/job/grant/recipe owned through ALL concurrent renderer calls;
+// release only after OSD quiescence/join. No free concurrent with predicate.
+// Revalidation temporarily withdraws eligibility until actual owner success;
+// it never renews the original deadline or authorizes another timing take.
+bool demux_reference_reader_publication_current(struct demux_reference_request *request);
