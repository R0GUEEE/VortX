+    return s->index == p->ff_index && s->id == p->av_stream_id &&
+        (s->start_time == p->stream_start_time ||
+         (!require_start && s->start_time == AV_NOPTS_VALUE)) &&
+        s->time_base.num == p->time_base.num &&
+        s->time_base.den == p->time_base.den && codec_equal(job->codecpar, s->codecpar);
+}
+
+static bool decode_pair(struct mp_reference_reader_job *job, AVCodecContext *ctx,
+                         AVPacket *packet, double relative_pts)
+{
+    double duration = packet->duration * av_q2d(job->spec.time_base);
+    bool ass = ctx->codec_id == AV_CODEC_ID_ASS || ctx->codec_id == AV_CODEC_ID_SSA;
+    double duration_ms = duration / 0.001;
+    double duration_end = relative_pts + duration;
+    // Exact rational guard covers the sentinel boundary even if the double
+    // conversion would round UINT32_MAX milliseconds down to MAX-1.
+    if (!ass && (packet->duration < 0 ||
+        av_compare_ts(packet->duration, job->spec.time_base, UINT32_MAX,
+                      (AVRational){1, 1000}) >= 0))
+        return false;
+    // lavc_conv passes packet PTS/duration in milliseconds, then interprets
+    // start/end_display_time in its explicitly forced 1/1000 timebase.
+    double presentation_pts = packet->pts * av_q2d(job->spec.time_base) +
+        job->spec.consumer_ts_offset;
+    double dts = packet->dts == AV_NOPTS_VALUE ? NAN :
+        packet->dts * av_q2d(job->spec.time_base) + job->spec.consumer_ts_offset;
+    // Exact binary double numerator preserves the old effective double bound,
+    // keeping about half the int64 range as margin for millisecond conversion.
+    const double max_decoder_seconds = 0x1p62 / 1000.0;
+    if (!isfinite(presentation_pts) || fabs(presentation_pts) > max_decoder_seconds ||
+        !isfinite(duration) || duration < 0 || duration > max_decoder_seconds ||
+        !isfinite(duration_end) ||
+        // libavcodec's non-ASS fallback assigns this rescaled duration to
+        // uint32_t end_display_time. Reject BEFORE decode, including its
+        // UINT32_MAX unknown-end sentinel, rather than admit a narrowed end.
+        (!ass && (!isfinite(duration_ms) || duration_ms >= UINT32_MAX)) ||
+        (isfinite(dts) && fabs(dts) > max_decoder_seconds))
+        return false;
+    packet->pts = llrint(presentation_pts / 0.001);
+    packet->dts = isfinite(dts) ? llrint(dts / 0.001) : AV_NOPTS_VALUE;
+    packet->duration = duration_ms; // mp_set_av_packet truncates duration
+    if (packet->pts < 0)
+        packet->pts = 0; // same decoder-input clamp as lavc_conv
+    AVSubtitle sub = {0};
+    int got = 0;
+    int decoded = avcodec_decode_subtitle2(ctx, &sub, &got, packet);
+    // movtextdec.c explicitly consumes the two-zero-byte end marker with
+    // ret=0, got=0: durations already define the prior cue's real end. Observe
+    // that decoder outcome, omit the marker, and never synthesize a cue.
+    if (ctx->codec_id == AV_CODEC_ID_MOV_TEXT && packet->size == 2 &&
+        packet->data[0] == 0 && packet->data[1] == 0 && decoded == 0 && !got &&
+        sub.num_rects == 0) {
+        avsubtitle_free(&sub);
+        return true;
+    }
+    bool good = decoded == packet->size && got && sub.num_rects > 0 &&
+        sub.start_display_time != UINT32_MAX;
+    for (unsigned n = 0; good && n < sub.num_rects; n++) {
+        AVSubtitleRect *rect = sub.rects[n];
+        good = rect && rect->type == SUBTITLE_ASS && rect->ass &&
+            rect->w == 0 && rect->h == 0;
+    }
+    double start = relative_pts + sub.start_display_time / 1000.0;
+    double end = relative_pts + sub.end_display_time / 1000.0;
+    // Native ASS playback uses its real packet duration. No unknown-duration
+    // heuristic or fabricated three-second end is allowed for any codec.
+    if (ass)
+        end = duration_end;
+    else {
+        good &= sub.end_display_time != UINT32_MAX;
+        // When decode.c filled end_display_time from packet duration, retain
+        // its original unwrapped finite end for the whole-cue window proof.
+        // A legitimate fractional native duration must not become an in-window
+        // cue merely because the decoder's millisecond field was truncated.
+        if (sub.end_display_time == packet->duration)
+            end = duration_end;
+    }
+    good &= isfinite(start) && isfinite(end) && end > start &&
+        (!ass || (isfinite(duration) && duration > 0));
+    // Match the existing reference path: omit a real cue crossing either
+    // boundary; never crop, rebase, or fabricate its duration to fit.
+    if (good && start >= 0 && end <= REFERENCE_WINDOW_MS / 1000.0) {
+        int64_t start_ms = llrint(start * 1000), end_ms = llrint(end * 1000);
+        unsigned n = job->result.num_pairs;
+        good = n < DEMUX_REFERENCE_MAX_PAIRS && end_ms > start_ms &&
+            (!n || start_ms >= job->result.pairs[n - 1].start_ms);
+        if (good) {
+            job->result.pairs[n] = (struct demux_reference_pair){start_ms, end_ms};
+            job->result.num_pairs++;
+        }
+    }
+    avsubtitle_free(&sub);
+    return good;
+}
+
+bool mp_reference_reader_job_run(struct mp_reference_reader_job *job,
+                               const AVIOInterruptCB *interrupt)
+{
+    if (!job || job->decoded || !interrupt || !interrupt->callback ||
+        mp_reference_reader_job_cancelled(job))
+        return false;
+    struct reader_io io = {.job = job, .interrupt = interrupt};
+    AVIOInterruptCB cb = {.callback = reader_interrupt, .opaque = &io};
+    AVFormatContext *fmt = NULL;
+    AVIOContext *pb = NULL;
+    AVCodecContext *decoder = NULL;
+    AVPacket *packet = NULL;
+    uint8_t *buffer = NULL;
+    AVDictionary *options = NULL;
+    bool complete = false, seen = false, ok = false;
+    double last_pts = -INFINITY;
+    if (!stream_reference_reader_open(job->grant, &cb, &io.reader))
+        goto done;
+    buffer = av_malloc(REFERENCE_AVIO_BYTES);
+    fmt = avformat_alloc_context();
+    if (!buffer || !fmt)
+        goto done;
+    pb = avio_alloc_context(buffer, REFERENCE_AVIO_BYTES, 0, &io,
+                            reader_read, NULL, NULL);
+    if (!pb)
+        goto done;
+    buffer = NULL; // pb owns; no seek callback, no second request or filename
+    pb->seekable = 0;
+    fmt->pb = pb;
+    fmt->flags = job->spec.format_flags;
+    fmt->interrupt_callback = cb;
+    fmt->opaque = &io;
+    fmt->io_open = deny_nested;
+    fmt->probesize = REFERENCE_AVIO_BYTES;
+    fmt->max_analyze_duration = 0;
+    fmt->max_streams = 1024;
+    // Admitted formats parse track headers at open; no find_stream_info
+    // scan is needed. Force the EXACT original static format, never autodetect.
+    if (reader_interrupt(&io) ||
+        avformat_open_input(&fmt, NULL, job->spec.format, NULL) < 0 ||
+        io.nested_attempt || !duplicate_matches(job, fmt, false))
+        goto done;
+    const AVCodec *codec = avcodec_find_decoder(job->codecpar->codec_id);
+    if (!codec || (codec->capabilities & AV_CODEC_CAP_DELAY))
+        goto done; // no delayed/reordered text decoder may certify the prefix
+    decoder = codec ? avcodec_alloc_context3(codec) : NULL;
+    if (decoder)
+        decoder->thread_count = 1;
+    packet = av_packet_alloc();
+    if (!decoder || !packet ||
+        avcodec_parameters_to_context(decoder, job->codecpar) < 0 ||
+        av_dict_set(&options, "sub_text_format", "ass", 0) < 0 ||
+        av_dict_set(&options, "flags2", "+ass_ro_flush_noop", 0) < 0 ||
+        avcodec_open2(decoder, codec, &options) < 0)
+        goto done;
+    av_dict_free(&options);
+    decoder->time_base = decoder->pkt_timebase = (AVRational){1, 1000};
+    decoder->sub_charenc_mode = FF_SUB_CHARENC_MODE_IGNORE;
+    for (;;) {
+        if (reader_interrupt(&io) || io.nested_attempt ||
+            job->result.packets_seen >= REFERENCE_PACKET_LIMIT)
+            goto done;
+        int rc = av_read_frame(fmt, packet);
+        if (reader_interrupt(&io) || io.nested_attempt ||
+            !duplicate_matches(job, fmt, seen ||
+                (rc >= 0 && packet->stream_index == job->spec.ff_index)))
+            goto done;
+        if (rc == AVERROR_EOF) {
+            struct avpriv_vortx_reference_stats stats = {0};
+            complete = avpriv_vortx_reference_stats_v1(io.reader,
+                &stats, sizeof(stats)) == 0 && !stats.terminal_error &&
+                stats.complete_entity && stats.reached_entity_eof && seen;
+            break;
+        }
+        if (rc < 0)
+            goto done;
+        job->result.packets_seen++;
+        if (packet->stream_index == job->spec.ff_index) {
+            double pts = packet->pts == AV_NOPTS_VALUE ? NAN :
+                packet->pts * av_q2d(job->spec.time_base) - job->spec.demux_start_time;
+            if (!isfinite(pts) || pts < 0 || pts < last_pts ||
+                packet->size <= 0 ||
+                packet->size > REFERENCE_PACKET_BYTES ||
+                (packet->flags & (AV_PKT_FLAG_CORRUPT | AV_PKT_FLAG_DISCARD)))
+                goto done;
+            seen = true;
+            last_pts = pts;
+            if (pts >= REFERENCE_WINDOW_MS / 1000.0) {
+                complete = true; // no more I/O once selected prefix spans window
+                break;
+            }
+            if (!decode_pair(job, decoder, packet, pts) || reader_interrupt(&io))
+                goto done;
+        }
+        av_packet_unref(packet);
+    }
+    // Even the out-of-window early stop must prove no decoder output is
+    // pending. All admitted codecs lack DELAY; empty input therefore must
+    // produce exactly no subtitle through the real libavcodec API.
+    AVSubtitle flushed = {0};
+    AVPacket empty = {0};
+    int got_flushed = 0;
+    int flush_rc = avcodec_decode_subtitle2(decoder, &flushed, &got_flushed, &empty);
+    bool drained = flush_rc == 0 && !got_flushed && !flushed.num_rects;
+    avsubtitle_free(&flushed);
+    struct avpriv_vortx_reference_stats stats = {0};
+    if (!complete || !drained || !job->result.num_pairs || reader_interrupt(&io) ||
+        avpriv_vortx_reference_stats_v1(io.reader, &stats, sizeof(stats)) < 0 ||
+        stats.terminal_error || stats.body_bytes > VORTX_REFERENCE_READER_MAX_BYTES ||
+        (pb && pb->error && pb->error != AVERROR_EOF))
+        goto done;
+    job->result.input_bytes = stats.body_bytes;
+    job->result.complete = true;
+    ok = true;
+done:
+    av_dict_free(&options);
+    av_packet_free(&packet);
+    avcodec_free_context(&decoder);
+    avformat_close_input(&fmt);
+    if (pb) {
+        av_freep(&pb->buffer);
+        avio_context_free(&pb);
+    }
+    av_free(buffer);
+    avpriv_vortx_reference_reader_close_v1(&io.reader);
+    job->decoded = ok && !mp_reference_reader_job_cancelled(job) &&
+        !interrupt->callback(interrupt->opaque);
+    if (!job->decoded) {
+        job->result.complete = false;
+        job->result.num_pairs = 0;
+        memset(job->result.pairs, 0, sizeof(job->result.pairs));
+    }
+    return job->decoded;
+}
+
+bool mp_reference_reader_job_copy_result(
+    const struct mp_reference_reader_job *job, struct demux_reference_result *out)
+{
+    if (!out || !job || !job->decoded || !job->result.complete ||
+        mp_reference_reader_job_cancelled(job))
+        return false;
+    *out = job->result;
+    return true;
+}
+
+#if defined(VORTX_REFERENCE_READER_SOURCE_FIXTURE)
+#include "reference_reader_fixture.inc"
+#endif
