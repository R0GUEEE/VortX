+// Specific retained demux-owner fence. Uses native unsigned atomics (including
+// Android32), never wraps, and owns no live demux/stream/cancel pointers.
+struct demux_reference_lifetime {
+    atomic_uint refs, epoch;
+    atomic_bool retired;
+};
+struct demux_internal;
+static void reference_epoch_advance(struct demux_internal *in);
+static void reference_owner_retire(struct demux_internal *in);
+
