+        !text_codec(spec->codecpar->codec_id) ||
+        !codec_equal(spec->codecpar, spec->codecpar) ||
+        !isfinite(spec->demux_start_time) || !isfinite(spec->consumer_ts_offset) ||
+        !isfinite(spec->demux_start_time + spec->consumer_ts_offset) ||
+        spec->stream_start_time == AV_NOPTS_VALUE ||
+        (spec->format_start_time == AV_NOPTS_VALUE ? spec->demux_start_time != 0 :
