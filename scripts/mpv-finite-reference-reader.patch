+    job->spec.codecpar = NULL; // never retain the borrowed original parameters
+    job->codecpar = avcodec_parameters_alloc();
+    if (!job->codecpar || avcodec_parameters_copy(job->codecpar, spec->codecpar) < 0 ||
+        !stream_reference_reader_capture(source, deadline_ns, &job->grant) ||
+        !stream_reference_reader_witness(job->grant,
+            &job->result.source_generation, &job->result.source_epoch,
+            &job->result.response_generation)) {
+        mp_reference_reader_job_free(&job);
+        return NULL;
+    }
+    job->result.stream_index = spec->stream_index;
+    job->result.demuxer_id = spec->demuxer_id;
+    job->result.ff_index = spec->ff_index;
+    job->result.av_stream_id = spec->av_stream_id;
+    job->result.format_kind = !strcmp(spec->format->name, "matroska,webm") ? 1 : 2;
+    job->result.codec_id = spec->codecpar->codec_id;
+    job->result.time_base_num = spec->time_base.num;
+    job->result.time_base_den = spec->time_base.den;
+    job->result.source_origin = spec->source_origin;
+    job->result.origin_seconds = spec->demux_start_time + spec->consumer_ts_offset;
+    job->result.prefix_end_ms = REFERENCE_WINDOW_MS;
+    return job;
+}
+
+bool mp_reference_reader_job_matches(
+    const struct mp_reference_reader_job *job,
+    const struct mp_reference_track_spec *s)
+{
+    const struct mp_reference_track_spec *p = job ? &job->spec : NULL;
+    return s && p && !mp_reference_reader_job_cancelled(job) &&
+        s->format == p->format && s->format_flags == p->format_flags &&
+        s->num_streams == p->num_streams &&
+        s->time_base.num == p->time_base.num && s->time_base.den == p->time_base.den &&
+        s->format_start_time == p->format_start_time &&
+        s->stream_start_time == p->stream_start_time &&
+        s->stream_index == p->stream_index && s->demuxer_id == p->demuxer_id &&
+        s->ff_index == p->ff_index && s->av_stream_id == p->av_stream_id &&
+        s->source_origin == p->source_origin &&
+        s->demux_start_time == p->demux_start_time &&
+        s->consumer_ts_offset == p->consumer_ts_offset &&
+        codec_equal(job->codecpar, s->codecpar);
+}
+
+bool mp_reference_reader_job_revalidate(
+    const struct mp_reference_reader_job *job, struct stream *source)
+{
+    return !mp_reference_reader_job_cancelled(job) &&
+        stream_reference_reader_revalidate(source, job->grant);
