diff --git a/player/reference_owned.inc b/player/reference_owned.inc
new file mode 100644
--- /dev/null
+++ b/player/reference_owned.inc
@@ -0,0 +1,455 @@
+/* Included only by owned_subtitle.c. Internal node transport; no public ABI.
+ * All functions enter/leave with the core locked. Unlocked phases retain only
+ * the command's outstanding_async core hold and genuinely owned request data.
+ */
+struct owned_reference {
+    int64_t grant;
+    int64_t deadline_ns;
+    struct owned_witness witness;
+    struct demux_reference_request *request;
+    struct demux_reference_result result;
+};
+
+static bool reference_current(void *opaque)
+{
+    struct owned_reference *r = opaque;
+    return r && demux_reference_reader_publication_current(r->request);
+}
+
+static void reference_release(void *opaque)
+{
+    struct owned_reference *r = opaque;
+    if (!r)
+        return;
+    demux_reference_request_cancel(r->request);
+    demux_reference_request_release(&r->request);
+    talloc_free(r);
+}
+
+static struct owned_reference *object_reference(const struct vortx_owned_text *o)
+{
+    return o && o->source_current == reference_current &&
+        o->source_release == reference_release ? o->source_lease : NULL;
+}
+
+static bool capture_object(struct MPContext *mpctx,
+                           const struct vortx_owned_text *object,
+                           struct owned_witness *out)
+{
+    struct owned_reference *r = object_reference(object);
+    if (!r)
+        return object && !object->source_lease && !object->source_current &&
+            !object->source_release && capture(mpctx, out);
+    if (!reference_current(r) || !capture_base(mpctx, true, out))
+        return false;
+    out->source = r->result.source_generation;
+    out->reference_grant = r->grant;
+    return same(out, &r->witness);
+}
+
+static void retire_reference(struct MPContext *mpctx)
+{
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    if (!s)
+        return;
+    if (s->reading_request)
+        demux_reference_request_cancel(s->reading_request);
+    if (!s->reference)
+        return;
+    struct owned_reference *r = object_reference(s->reference);
+    mp_assert(r);
+    demux_reference_request_cancel(r->request);
+    if (s->reference_busy) {
+        // The command worker still owns a borrow across unlocked work. The
+        // worker, not this scalar retirement body, queues the final free.
+        s->reference_retired = true;
+    } else {
+        retire_object(s, s->reference);
+        s->reference = NULL;
+        s->reference_retired = false;
+    }
+}
+
+static void reference_end_busy(struct MPContext *mpctx, bool keep)
+{
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    mp_assert(s->reference && s->reference_busy);
+    s->reference_busy = false;
+    if (!keep || s->reference_retired) {
+        retire_object(s, s->reference);
+        s->reference = NULL;
+        s->reference_retired = false;
+        kick_reaper(mpctx);
+    }
+}
+
+static bool reference_wait(struct mp_cmd_ctx *cmd,
+                           struct demux_reference_request *request,
+                           enum demux_reference_reader_status pending,
+                           enum demux_reference_reader_status success)
+{
+    // Utility command worker only, core unlocked. No live demux, stream,
+    // AVIO, callback from a new owner, or renderer lock is borrowed here.
+    for (;;) {
+        if (mp_cancel_test(cmd->abort->cancel)) {
+            demux_reference_request_cancel(request);
+            return false;
+        }
+        enum demux_reference_reader_status state =
+            demux_reference_reader_status(request);
+        if (state != pending)
+            return state == success;
+        mp_cancel_wait(cmd->abort->cancel, 0.002);
+    }
+}
+
+static void reference_abort_request(void *opaque)
+{
+    // mp_cancel invokes callbacks while holding its own/parent locks. Only an
+    // independent atomic request cancellation is permitted in this callback.
+    demux_reference_request_cancel(opaque);
+}
+
+static bool reference_owner_revalidate(struct mp_cmd_ctx *cmd,
+                                       struct vortx_owned_text *object,
+                                       const struct owned_witness *original)
+{
+    struct MPContext *mpctx = cmd->mpctx;
+    struct owned_reference *r = object_reference(object);
+    struct owned_witness now;
+    if (!r || mp_cancel_test(cmd->abort->cancel) ||
+        !capture_object(mpctx, object, &now) || !same(original, &now) ||
+        !demux_reference_reader_revalidate(mpctx->demuxer, r->request))
+        return false;
+    mp_core_unlock(mpctx);
+    bool ready = reference_wait(cmd, r->request,
+        DEMUX_REFERENCE_READER_REVALIDATING, DEMUX_REFERENCE_READER_READY);
+    mp_core_lock(mpctx);
+    return ready && !mp_cancel_test(cmd->abort->cancel) &&
+        capture_object(mpctx, object, &now) && same(original, &now);
+}
+
+static void reference_capture_node(struct mpv_node *node,
+                                    const struct owned_witness *w)
+{
+    node_map_add_int64(node, "intent-generation", w->intent);
+    node_map_add_int64(node, "entry-id", w->entry);
+    node_map_add_int64(node, "sid", w->sid);
+    node_map_add_int64(node, "ff-index", w->ff_index);
+    node_map_add_double(node, "demux-origin", w->origin);
+    node_map_add_flag(node, "primary-visible", w->visible);
+}
+
+int mp_property_vortx_subtitle_reference(void *p, struct m_property *prop,
+                                        int action, void *arg)
+{
+    struct owned_witness w;
+    if (!capture_base(p, true, &w) || !w.visible)
+        return M_PROPERTY_UNAVAILABLE;
+    if (action == M_PROPERTY_GET_TYPE) {
+        *(struct m_option *)arg = (struct m_option){.type = CONF_TYPE_NODE};
+        return M_PROPERTY_OK;
+    }
+    if (action != M_PROPERTY_GET)
+        return M_PROPERTY_NOT_IMPLEMENTED;
+    struct mpv_node *node = arg;
+    node_init(node, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(node, "version", 1);
+    reference_capture_node(node, &w);
+    return M_PROPERTY_OK;
+}
+
+int mp_property_vortx_subtitle_reference_active(void *p, struct m_property *prop,
+                                               int action, void *arg)
+{
+    struct MPContext *mpctx = p;
+    struct vortx_owned_text *active = mpctx->osd ?
+        osd_vortx_owned_text_current(mpctx->osd) : NULL;
+    struct owned_reference *r = object_reference(active);
+    struct owned_witness w;
+    if (!r || !capture_object(mpctx, active, &w))
+        return M_PROPERTY_UNAVAILABLE;
+    if (action == M_PROPERTY_GET_TYPE) {
+        *(struct m_option *)arg = (struct m_option){.type = CONF_TYPE_NODE};
+        return M_PROPERTY_OK;
+    }
+    if (action != M_PROPERTY_GET)
+        return M_PROPERTY_NOT_IMPLEMENTED;
+    struct mpv_node *node = arg;
+    node_init(node, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(node, "version", 1);
+    node_map_add_int64(node, "grant", r->grant);
+    node_map_add_int64(node, "ticket", active->ticket);
+    reference_capture_node(node, &w);
+    node_map_add_int64(node, "source-generation", w.source);
+    return M_PROPERTY_OK;
+}
+
+static bool reference_read_args(struct mp_cmd_ctx *cmd,
+                                const struct owned_witness *w)
+{
+    return cmd->args[0].v.i64 == w->intent &&
+        cmd->args[1].v.i64 == w->entry &&
+        cmd->args[2].v.i64 == w->sid &&
+        cmd->args[3].v.i64 == w->ff_index &&
+        cmd->args[4].v.d == w->origin;
+}
+
+void cmd_vortx_subtitle_reference_read(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    struct owned_witness original, current;
+    cmd->success = false;
+    if (!s || s->preparing || s->reading_request || s->reference || s->ready ||
+        s->retired_count || s->reaping_count || s->sequence == INT64_MAX ||
+        mp_cancel_test(cmd->abort->cancel) ||
+        !capture_base(mpctx, true, &original) || !original.visible ||
+        !reference_read_args(cmd, &original))
+        return;
+    struct track *primary = mpctx->current_track[0][STREAM_SUB];
+    // Identity comparison only after reacquiring the core; the unlocked worker
+    // never dereferences this pointer and the request owns no live demux borrow.
+    struct demuxer *original_demux = mpctx->demuxer;
+    int64_t deadline = mp_time_ns() + MP_TIME_S_TO_NS(30);
+    struct demux_reference_request *request = demux_reference_reader_request(
+        mpctx->demuxer, primary->stream->index, deadline);
+    if (!request)
+        return;
+    struct mp_cancel *abort_link = mp_cancel_try_new(NULL);
+    if (!abort_link) {
+        demux_reference_request_cancel(request);
+        mp_core_unlock(mpctx);
+        demux_reference_request_release(&request);
+        mp_core_lock(mpctx);
+        return;
+    }
+    // A private slave preserves the existing command cancel callback. It also
+    // propagates async-abort DURING the synchronous duplicate I/O/decode call,
+    // rather than waiting for that call or the thirty-second deadline to end.
+    mp_cancel_set_cb(abort_link, reference_abort_request, request);
+    mp_cancel_set_parent(abort_link, cmd->abort->cancel);
+    int64_t grant = ++s->sequence;
+    s->reading_request = request; // non-owning, safe concurrent cancel only
+    s->reading_grant = grant;
+    mp_core_unlock(mpctx);
+    bool decoded = reference_wait(cmd, request, DEMUX_REFERENCE_READER_PENDING,
+        DEMUX_REFERENCE_READER_CAPTURED) && demux_reference_reader_run(request);
+    mp_core_lock(mpctx); // synchronous run joined all owned reader/decoder use
+    bool current_owner = decoded && mpctx->demuxer == original_demux &&
+        !mp_cancel_test(cmd->abort->cancel) &&
+        capture_base(mpctx, true, &current) && same(&original, &current);
+    bool queued = current_owner &&
+        demux_reference_reader_revalidate(mpctx->demuxer, request);
+    mp_core_unlock(mpctx);
+    bool ready = queued && reference_wait(cmd, request,
+        DEMUX_REFERENCE_READER_REVALIDATING, DEMUX_REFERENCE_READER_READY);
+    struct demux_reference_result result = {0};
+    ready = ready && demux_reference_reader_take(request, &result);
+    mp_core_lock(mpctx);
+    mp_assert(s->reading_request == request && s->reading_grant == grant);
+    s->reading_request = NULL;
+    s->reading_grant = 0;
+    // Detachment joins any in-flight parent callback before this command can
+    // finish or the request can transfer/release. No borrowed abort survives.
+    mp_cancel_set_parent(abort_link, NULL);
+    mp_cancel_set_cb(abort_link, NULL, NULL);
+    talloc_free(abort_link);
+    ready = ready && mpctx->demuxer == original_demux &&
+        !mp_cancel_test(cmd->abort->cancel) &&
+        capture_base(mpctx, true, &current) && same(&original, &current) &&
+        demux_reference_reader_publication_current(request) &&
+        result.complete && result.source_generation > 0 &&
+        result.response_generation > 0 && result.source_epoch > 0 &&
+        result.source_epoch <= INT64_MAX && result.demux_epoch > 0 &&
+        result.ff_index == original.ff_index && isfinite(result.origin_seconds) &&
+        fabs(result.origin_seconds) <= 86400 && result.prefix_start_ms == 0 &&
+        result.prefix_end_ms == 1080000 && result.num_pairs > 0 &&
+        result.num_pairs <= DEMUX_REFERENCE_MAX_PAIRS && !s->reference;
+    if (!ready) {
+        demux_reference_request_cancel(request);
+        mp_core_unlock(mpctx);
+        demux_reference_request_release(&request);
+        mp_core_lock(mpctx);
+        return; // no grant has become reachable from a node or renderer
+    }
+    struct owned_reference *r = talloc_zero(NULL, struct owned_reference);
+    original.source = result.source_generation;
+    original.reference_grant = grant;
+    *r = (struct owned_reference){.grant = grant, .deadline_ns = deadline,
+        .witness = original,
+        .request = request, .result = result};
+    struct vortx_owned_text *object = talloc_zero(NULL, struct vortx_owned_text);
+    *object = (struct vortx_owned_text){.source_lease = r,
+        .source_current = reference_current, .source_release = reference_release};
+    s->reference = object;
+    // A paused/idle core must also revisit this finite uncommitted grant.
+    // The normal core update arms its one deadline; active OSD leases do not
+    // poll or inherit this operation timeout.
+    mp_wakeup_core(mpctx);
+    node_init(&cmd->result, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(&cmd->result, "version", 1);
+    node_map_add_int64(&cmd->result, "grant", grant);
+    reference_capture_node(&cmd->result, &original);
+    node_map_add_int64(&cmd->result, "source-generation", result.source_generation);
+    node_map_add_int64(&cmd->result, "response-generation", result.response_generation);
+    node_map_add_int64(&cmd->result, "source-epoch", result.source_epoch);
+    node_map_add_int64(&cmd->result, "demux-epoch", result.demux_epoch);
+    node_map_add_double(&cmd->result, "origin", result.origin_seconds);
+    node_map_add_int64(&cmd->result, "prefix-start-ms", result.prefix_start_ms);
+    node_map_add_int64(&cmd->result, "prefix-end-ms", result.prefix_end_ms);
+    struct mpv_node *cues = node_map_add(&cmd->result, "cues", MPV_FORMAT_NODE_ARRAY);
+    for (unsigned n = 0; n < result.num_pairs; n++) {
+        struct mpv_node *pair = node_array_add(cues, MPV_FORMAT_NODE_ARRAY);
+        node_array_add(pair, MPV_FORMAT_INT64)->u.int64 = result.pairs[n].start_ms;
+        node_array_add(pair, MPV_FORMAT_INT64)->u.int64 = result.pairs[n].end_ms;
+    }
+    cmd->success = true;
+}
+
+void cmd_vortx_subtitle_reference_prepare(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    struct vortx_owned_text *object = s ? s->reference : NULL;
+    struct owned_reference *r = object_reference(object);
+    struct owned_witness original;
+    cmd->success = false;
+    if (!s || s->preparing || s->reference_busy || s->ready ||
+        s->retired_count || s->reaping_count || s->sequence == INT64_MAX ||
+        !r || cmd->args[0].v.i64 != r->grant ||
+        !capture_object(mpctx, object, &original) || !args_match(cmd, 1, &original))
+        return;
+    s->reference_busy = true;
+    s->preparing = true;
+    bool valid = reference_owner_revalidate(cmd, object, &original);
+    struct attachment_list *attachments = valid ? copy_attachments(mpctx->demuxer) : NULL;
+    int64_t ticket = ++s->sequence;
+    struct dec_sub *decoder = NULL;
+    if (attachments) {
+        struct mpv_global *global = mpctx->global;
+        // Constructor work shares the ORIGINAL operation deadline; the
+        // per-constructor allowance cannot extend a nearly expired grant.
+        int64_t deadline = MPMIN(r->deadline_ns,
+                                 mp_time_ns() + SUB_OWNED_TEXT_MAX_WORK_NS);
+        mp_core_unlock(mpctx);
+        decoder = decode_payload(global, attachments, cmd->args[7].v.s,
+            original.play_dir, original.video_fps, cmd->abort->cancel, deadline);
+        mp_core_lock(mpctx);
+    }
+    struct owned_witness current;
+    valid = decoder && !s->reference_retired &&
+        !mp_cancel_test(cmd->abort->cancel) &&
+        // status includes the original <=30s operation deadline here.
+        demux_reference_reader_status(r->request) == DEMUX_REFERENCE_READER_READY &&
+        capture_object(mpctx, object, &current) && same(&original, &current);
+    s->preparing = false;
+    reference_end_busy(mpctx, valid);
+    if (!valid) {
+        mp_core_unlock(mpctx);
+        if (decoder)
+            sub_destroy_owned_text(decoder);
+        mp_core_lock(mpctx);
+        return;
+    }
+    object->ticket = ticket;
+    object->decoder = decoder;
+    s->reference = NULL; // ownership moves whole into the existing ready slot
+    s->ready = object;
+    s->ready_witness = original;
+    node_init(&cmd->result, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(&cmd->result, "version", 1);
+    node_map_add_int64(&cmd->result, "grant", r->grant);
+    node_map_add_int64(&cmd->result, "ticket", ticket);
+    cmd->success = true;
+}
+
+void cmd_vortx_subtitle_reference_commit(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    struct vortx_owned_text *object = s ? s->ready : NULL;
+    struct owned_reference *r = object_reference(object);
+    struct owned_witness original;
+    cmd->success = false;
+    if (!s || s->preparing || s->reference || s->reference_busy ||
+        s->retired_count || s->reaping_count || !r ||
+        cmd->args[0].v.i64 != object->ticket || cmd->args[1].v.i64 != r->grant ||
+        !capture_object(mpctx, object, &original) ||
+        !same(&s->ready_witness, &original) || !args_match(cmd, 2, &original))
+        return;
+    // Make the pending object non-publishable and retain its sole ownership
+    // across unlocked owner revalidation. Retirement cancels, never frees it.
+    s->ready = NULL;
+    s->reference = object;
+    s->reference_busy = true;
+    s->preparing = true;
+    bool valid = reference_owner_revalidate(cmd, object, &original) &&
+        !s->reference_retired && !mp_cancel_test(cmd->abort->cancel);
+    struct owned_witness current;
+    valid = valid && capture_object(mpctx, object, &current) && same(&original, &current);
+    s->preparing = false;
+    reference_end_busy(mpctx, valid);
+    if (!valid)
+        return;
+    s->reference = NULL;
+    // The immediate current predicate includes the original response lifetime
+    // token. OSD repeats it before AND after genuine bitmap generation, so a
+    // reconnect racing this exchange cannot leak a stale subtitle bitmap.
+    retire_object(s, osd_vortx_owned_text_exchange(mpctx->osd, object));
+    s->active_witness = current;
+    node_init(&cmd->result, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(&cmd->result, "version", 1);
+    node_map_add_int64(&cmd->result, "grant", r->grant);
+    node_map_add_int64(&cmd->result, "ticket", object->ticket);
+    node_map_add_flag(&cmd->result, "committed", true);
+    cmd->success = true;
+    mp_notify_property(mpctx, "vortx-owned-subtitle-state");
+    mp_wakeup_core(mpctx);
+}
+
+void cmd_vortx_subtitle_reference_revoke(void *p)
+{
+    struct mp_cmd_ctx *cmd = p;
+    struct MPContext *mpctx = cmd->mpctx;
+    struct vortx_owned_subtitle *s = mpctx->vortx_owned_subtitle;
+    int64_t grant = cmd->args[0].v.i64;
+    bool released = false;
+    if (s && grant > 0) {
+        if (s->reading_grant == grant) {
+            demux_reference_request_cancel(s->reading_request);
+            released = true;
+        }
+        struct owned_reference *pending = object_reference(s->reference);
+        if (pending && pending->grant == grant) {
+            retire_reference(mpctx);
+            released = true;
+        }
+        struct owned_reference *ready = object_reference(s->ready);
+        if (ready && ready->grant == grant) {
+            demux_reference_request_cancel(ready->request);
+            retire_object(s, s->ready);
+            s->ready = NULL;
+            released = true;
+        }
+        struct vortx_owned_text *active = mpctx->osd ?
+            osd_vortx_owned_text_current(mpctx->osd) : NULL;
+        struct owned_reference *live = object_reference(active);
+        if (live && live->grant == grant) {
+            demux_reference_request_cancel(live->request);
+            retire_object(s, osd_vortx_owned_text_exchange(mpctx->osd, NULL));
+            released = true;
+        }
+    }
+    node_init(&cmd->result, MPV_FORMAT_NODE_MAP, NULL);
+    node_map_add_int64(&cmd->result, "version", 1);
+    node_map_add_flag(&cmd->result, "released", released);
+    if (released) {
+        kick_reaper(mpctx);
+        mp_notify_property(mpctx, "vortx-owned-subtitle-state");
+        mp_wakeup_core(mpctx);
+    }
+}
