+    struct stream_reference_reader_grant *grant = av_mallocz(sizeof(*grant));
+    char *url = NULL;
+    AVDictionary *options = NULL;
+    if (!grant || !stream_reference_source_observe_sent_request(
+                      s, deadline_ns, &grant->sent) ||
+        !stream_reference_source_prepare_prefix_request(s, grant->sent,
+            STREAM_REFERENCE_PREFIX_MAX_BYTES, &url, &options))
+        goto fail;
+    struct lavf_priv *p = s->priv;
+    int64_t remaining_us = (deadline_ns - mp_time_ns()) / 1000;
+    if (remaining_us <= 0 || stream_reference_reader_cancelled(grant) ||
+        !p || !p->avio || avpriv_vortx_reference_capture_v1(p->avio,
+            &grant->sent->sent, sizeof(grant->sent->sent),
+            grant->sent->observation->values.etag, url, options,
+            STREAM_REFERENCE_PREFIX_MAX_BYTES, remaining_us, &grant->recipe) < 0 ||
+        !stream_reference_source_revalidate_sent_request(s, grant->sent) ||
+        stream_reference_reader_cancelled(grant))
+        goto fail;
+    av_free(url);
+    av_dict_free(&options);
+    *out = grant;
+    return true;
+fail:
+    av_free(url);
+    av_dict_free(&options);
+    stream_reference_reader_release(&grant);
     return false;
+}
+
+bool stream_reference_reader_revalidate(
+    stream_t *s, const struct stream_reference_reader_grant *grant)
+{
+    if (stream_reference_reader_cancelled(grant) ||
+        !stream_reference_source_revalidate_sent_request(s, grant->sent))
+        return false;
+    struct lavf_priv *p = s->priv;
+    return p && p->avio && avpriv_vortx_reference_revalidate_v1(p->avio,
+        &grant->sent->sent, sizeof(grant->sent->sent), grant->recipe) == 0 &&
+        stream_reference_source_revalidate_sent_request(s, grant->sent) &&
+        !stream_reference_reader_cancelled(grant);
 }
 
+bool stream_reference_reader_witness(
+    const struct stream_reference_reader_grant *grant,
+    int64_t *source_generation, uint64_t *epoch, int64_t *response_generation)
+{
+    if (!source_generation || !epoch || !response_generation ||
+        stream_reference_reader_cancelled(grant))
+        return false;
+    const struct stream_reference_observation_values *v =
+        &grant->sent->observation->values;
+    *source_generation = v->source_generation;
+    *epoch = v->source_epoch;
+    *response_generation = v->response_generation;
+    return !stream_reference_reader_cancelled(grant);
+}
+
+bool stream_reference_reader_open(
+    const struct stream_reference_reader_grant *grant,
+    const AVIOInterruptCB *interrupt,
+    struct avpriv_vortx_reference_reader **out)
+{
+    return out && !*out && !stream_reference_reader_cancelled(grant) &&
+        avpriv_vortx_reference_open_prefix_v1(grant->recipe, interrupt, out) == 0;
+}
