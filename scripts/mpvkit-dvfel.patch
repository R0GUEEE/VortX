+def fail(message):
+    raise ValueError('crypto-chain: ' + message)
+
+
+def digest_bytes(data):
+    return hashlib.sha256(data).hexdigest()
+
+
+class InlineBudget:
+    def __init__(self):
+        self.raw_bytes = 0
+
+    def add(self, count):
+        self.raw_bytes += count
+        if self.raw_bytes > MAX_INLINE_RAW:
+            fail('aggregate inline body bytes exceed cap')
+
+
+def decode_body_row(row, maximum, budget):
+    if type(row) is not dict or set(row) != {'path', 'bytes', 'sha256', 'bodyBase64'}:
+        fail('inline body row field set differs')
+    name, count, sha, encoded = (row[key] for key in ('path', 'bytes', 'sha256', 'bodyBase64'))
+    if (type(name) is not str or not name or len(name) > 4096 or name.startswith('/')
+            or '\\' in name or ':' in name or not name.isprintable()
+            or any(part in ('', '.', '..') for part in name.split('/'))):
+        fail('inline body row path is not relative')
+    if type(count) is not int or not 0 < count <= maximum:
+        fail('inline body raw size differs from cap')
+    if type(sha) is not str or re.fullmatch(r'[0-9a-f]{64}', sha) is None:
+        fail('inline body hash is malformed')
+    if (type(encoded) is not str or not encoded.isascii()
+            or len(encoded) > 4 * ((maximum + 2) // 3)
+            or re.fullmatch(r'(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?', encoded) is None):
+        fail('inline body is not canonical base64')
+    try:
+        body = base64.b64decode(encoded, validate=True)
+    except (ValueError, binascii.Error):
+        fail('inline body is not canonical base64')
+    if base64.b64encode(body).decode('ascii') != encoded:
+        fail('inline body is not canonical base64')
+    if len(body) != count or digest_bytes(body) != sha:
+        fail('inline body bytes/hash differ')
+    budget.add(len(body))
+    return body
+
+
+def inline_row(row, body, maximum, budget):
+    result = {**row, 'bodyBase64': base64.b64encode(body).decode('ascii')}
+    decode_body_row(result, maximum, budget)
+    return result
+
+
+def inline_file(path, root, maximum, budget):
+    row, body = read_verified(path, root, maximum)
+    return inline_row(row, body, maximum, budget)
+
+
+def validate_inline_bodies(receipt):
+    budget = InlineBudget()
+    for row in receipt['rows']:
+        builds = row.get('builds')
+        if type(builds) is not dict or set(builds) != {'gmp', 'nettle', 'gnutls'}:
+            fail('inline build family set differs')
+        for library, build in builds.items():
+            if type(build) is not dict or set(build) != {'record', 'generatedConfiguration', 'installedConfiguration', 'sdkMetadata'}:
+                fail('inline evidence family set differs')
+            decode_body_row(build['record'], MAX_HEADER, budget)
+            families = ((build['generatedConfiguration'], set(GENERATED + EXTRA_GENERATED[library]), MAX_CONFIGURATION),
+                        (build['installedConfiguration'], set(INSTALLED_CONFIGURATION[library].values()), MAX_CONFIGURATION),
+                        (build['sdkMetadata'], {'zlib.pc', 'libxml-2.0.pc'}, MAX_HEADER))
+            for family, names, maximum in families:
+                if type(family) is not dict or set(family) != names:
+                    fail('inline evidence member set differs')
+                for evidence in family.values():
+                    decode_body_row(evidence, maximum, budget)
+    return budget.raw_bytes
+
