+def build_record(work, library, platform, arch, sdk_tools, budget=None):
+    if budget is None:
+        budget = InlineBudget()
+    expected = recipe_contract(work, library, platform, arch, sdk_tools)
+    scratch = Path(expected['buildDirectory'])
+    record_path = scratch / 'vortx-crypto-build.json'
+    row, body = read_verified(record_path, work, MAX_HEADER)
+    record = strict_json(body)
+    if not isinstance(record, dict) or set(record) != set(expected) | {'generatedConfiguration'}:
+        fail('build record field set differs')
+    if not exact_equal({key: record[key] for key in expected}, expected):
+        fail('configured build recipe differs from the fixed source policy')
+    generated = record['generatedConfiguration']
+    names = GENERATED + EXTRA_GENERATED[library]
+    if not isinstance(generated, dict) or set(generated) != set(names):
+        fail('generated configuration set differs')
+    configurations = {}
+    for name in names:
+        observed = inline_file(scratch / name, work, MAX_CONFIGURATION, budget)
+        if not exact_equal(generated[name], {key: observed[key] for key in ('bytes', 'sha256')}):
+            fail('generated configuration differs from the actual build file')
+        configurations[name] = observed
+    installed = {}
+    for name, relative in INSTALLED_CONFIGURATION[library].items():
+        observed = inline_file(Path(expected['prefix']) / relative, work, MAX_CONFIGURATION, budget)
+        if any(observed[key] != configurations[name][key] for key in ('bytes', 'sha256')):
+            fail('installed generated header/pkg-config file differs from its build output')
+        installed[relative] = observed
+    # These two files are inputs from the existing bounded SDK metadata helper.
+    sdk_metadata = {name: inline_file(scratch / 'vortx-sdk-pkgconfig' / name, work, MAX_HEADER, budget)
+                    for name in ('zlib.pc', 'libxml-2.0.pc')}
+    return {'record': inline_row(row, body, MAX_HEADER, budget), 'generatedConfiguration': configurations,
+            'installedConfiguration': installed, 'sdkMetadata': sdk_metadata}
+
+
+def local_manifest(package):
+    row, text = text_file(package / 'Package.swift', package)
+    for target, *_ in LIBRARIES:
+        pattern = (r'\.binaryTarget\s*\(\s*name:\s*"' + re.escape(target)
+                   + r'"\s*,\s*path:\s*"artifacts/' + re.escape(target) + r'\.xcframework"\s*\)')
+        if len(re.findall(pattern, text, re.S)) != 1:
+            fail('candidate must bind one local target ' + target)
+        remote = r'name:\s*"' + re.escape(target) + r'"\s*,\s*url:'
+        if re.search(remote, text):
+            fail('candidate retains a remote target ' + target)
+    return row
+
+
+def xcframework_identity(package, target, binary_name):
+    root = package / 'artifacts' / (target + '.xcframework')
+    expected_slices = {slice_name for _, _, slice_name in MATRIX}
+    if root.resolve() != root or not root.is_dir() or {path.name for path in root.iterdir()} != expected_slices | {'Info.plist'}:
+        fail('XCFramework directory has missing or extra slices')
+    row, data = read_verified(root / 'Info.plist', package, MAX_HEADER)
+    metadata = plistlib.loads(data)
+    if (not isinstance(metadata, dict) or metadata.get('CFBundlePackageType') != 'XFWK'
+            or metadata.get('XCFrameworkFormatVersion') != '1.0'):
+        fail('invalid XCFramework container metadata')
+    available = metadata.get('AvailableLibraries')
+    if not isinstance(available, list) or len(available) != len(expected_slices):
+        fail('XCFramework slice declaration set differs')
+    declarations = {}
+    for library in available:
+        if not isinstance(library, dict):
+            fail('invalid XCFramework slice declaration')
+        identifier = library.get('LibraryIdentifier')
+        if type(identifier) is not str or identifier not in expected_slices or identifier in declarations:
+            fail('unknown or duplicate XCFramework slice declaration')
+        archs = sorted({arch for _, arch, slice_name in MATRIX if slice_name == identifier})
+        platform = 'macos' if identifier.startswith('macos-') else 'tvos' if identifier.startswith('tvos-') else 'ios'
+        expected = {'LibraryIdentifier': identifier, 'LibraryPath': binary_name + '.framework',
+                    'SupportedArchitectures': archs, 'SupportedPlatform': platform}
+        if identifier.endswith('-simulator'):
+            expected['SupportedPlatformVariant'] = 'simulator'
+        actual = dict(library)
+        actual_archs = actual.get('SupportedArchitectures')
+        if not isinstance(actual_archs, list) or any(type(value) is not str for value in actual_archs):
+            fail('invalid XCFramework architecture declaration')
+        actual['SupportedArchitectures'] = sorted(actual_archs)
+        if actual != expected:
+            fail('XCFramework platform/architecture/library metadata differs')
+        declarations[identifier] = expected
+    return row
+
+
+def snapshot_regular(path, root, scratch, name):
+    """Inspect a private byte copy, then reread its original identity."""
+    row = regular(path, root, MAX_ARCHIVE)
+    copy = Path(scratch) / name
+    source = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    destination = None
+    try:
+        destination = os.open(copy, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+        if not stat.S_ISREG(os.fstat(source).st_mode):
+            fail('archive changed to a non-regular input')
+        h, count = hashlib.sha256(), 0
+        with os.fdopen(source, 'rb', closefd=False) as incoming, os.fdopen(destination, 'wb', closefd=False) as outgoing:
+            for block in iter(lambda: incoming.read(1024 * 1024), b''):
+                count += len(block)
+                if count > MAX_ARCHIVE:
+                    fail('archive grew beyond bound')
+                h.update(block)
+                outgoing.write(block)
+            outgoing.flush()
+        if (count, h.hexdigest()) != (row['bytes'], row['sha256']) or regular(path, root, MAX_ARCHIVE) != row:
+            fail('archive changed during private snapshot')
+    finally:
+        os.close(source)
+        if destination is not None:
+            os.close(destination)
+    return row, copy
+
+
+def normalized_gmp_header(body):
+    """Only the two generated diagnostic compiler strings may vary by arch."""
+    text = body.decode('utf-8', errors='strict')
+    for name in ('__GMP_CC', '__GMP_CFLAGS'):
+        definitions = re.findall(r'(?m)^[ \t]*#[ \t]*define[ \t]+' + name + r'\b[^\r\n]*$', text)
+        pattern = (r'(?m)^[ \t]*#[ \t]*define[ \t]+' + name
+                   + r'[ \t]+"(?:[^"\\\r\n]|\\[^\r\n])*"[ \t]*$')
+        if len(definitions) != 1 or len(re.findall(pattern, text)) != 1:
+            fail('GMP diagnostic macro has an unapproved shape: ' + name)
+        text = re.sub(pattern, '#define ' + name + ' "<generated-diagnostic>"', text)
+    return text.encode('utf-8')
+
+
+def header_correspondence(target, work, package, prefix, framework, slice_name,
+                          thin_headers, packaged_headers):
+    if target != 'gmp':
+        if [(row['bytes'], row['sha256']) for row in thin_headers] != [(row['bytes'], row['sha256']) for row in packaged_headers]:
+            fail('packaged checked headers differ from the current thin build')
+        return {'kind': 'exact-checked-header-bytes'}
+    _, current = read_verified(prefix / 'include/gmp.h', work, MAX_HEADER)
+    _, packaged = read_verified(framework / 'Headers/gmp.h', package, MAX_HEADER)
+    normalized = normalized_gmp_header(current)
+    if normalized_gmp_header(packaged) != normalized:
+        fail('packaged GMP header differs beyond generated compiler diagnostics')
+    matches = []
+    for platform, arch, candidate_slice in MATRIX:
+        if candidate_slice != slice_name:
+            continue
+        headers = work / 'dist/gmp' / platform / 'thin' / arch / 'include'
+        check_headers('gmp', headers, work)
+        row, body = read_verified(headers / 'gmp.h', work, MAX_HEADER)
+        if normalized_gmp_header(body) != normalized:
+            fail('GMP thin headers differ beyond generated compiler diagnostics')
+        if body == packaged:
+            matches.append({'platform': platform, 'arch': arch, 'header': row})
+    if not matches:
+        fail('packaged GMP header is not the exact body of any selected thin header')
+    return {'kind': 'gmp-two-generated-diagnostic-strings-only',
+            'normalizedSHA256': digest_bytes(normalized), 'packagedHeaderFrom': matches}
+
+
+def framework_layout(framework, binary_name, slice_name, package):
+    if not slice_name.startswith('macos-'):
+        return framework / binary_name, {'kind': 'shallow'}
+    # BaseBuild.fixShallowBundles creates precisely this macOS layout. This is
+    # not a general symlink resolver and grants no archive-source exception.
+    links = {'Versions/Current': 'A', binary_name: 'Versions/Current/' + binary_name,
+             'Resources': 'Versions/Current/Resources'}
+    observations = []
+    for name, target in links.items():
+        path = framework / name
+        if not path.is_symlink() or os.readlink(path) != target:
+            fail('macOS framework link differs from the fixed BaseBuild layout')
+        encoded = target.encode('utf-8')
+        observations.append({'path': path.relative_to(package).as_posix(),
+                             'target': target, 'bytes': len(encoded), 'sha256': digest_bytes(encoded)})
+    versions, version_a = framework / 'Versions', framework / 'Versions/A'
+    if (versions.is_symlink() or version_a.is_symlink() or not versions.is_dir() or not version_a.is_dir()
+            or {path.name for path in versions.iterdir()} != {'A', 'Current'}
+            or {path.name for path in version_a.iterdir()} != {binary_name, 'Resources'}):
+        fail('macOS framework version directory differs')
+    resources = version_a / 'Resources'
+    if resources.is_symlink() or not resources.is_dir() or {path.name for path in resources.iterdir()} != {'Info.plist'}:
+        fail('macOS framework resource directory differs')
+    info = regular(resources / 'Info.plist', package, MAX_HEADER)
+    return version_a / binary_name, {'kind': 'fixed-macos-versions-A', 'links': observations, 'info': info}
+
+
+def capture_evidence(work, package, scratch):
+    tools = resolved_tools(scratch)
+    lipo, nm = tools['lipo']['resolvedPath'], tools['nm']['resolvedPath']
+    manifest = local_manifest(package)
+    containers = {target: xcframework_identity(package, target, binary_name)
+                  for target, _, _, binary_name in LIBRARIES}
+    source_boundary = regular(work / 'dist/crypto-sources/receipt.json', work, MAX_RECEIPT)
+    rows = []
+    reader_budget = len(json.dumps(tools['toolchainVersion'], ensure_ascii=True).encode('ascii'))
+    inline_budget = InlineBudget()
+    slices = {slice_name: sorted({arch for _, arch, value in MATRIX if value == slice_name}) for _, _, slice_name in MATRIX}
+    for platform, arch, slice_name in MATRIX:
+        library_rows, observations = {}, {}
+        builds = {library: build_record(work, library, platform, arch, tools['platforms'][platform], inline_budget)
+                  for library in ('gmp', 'nettle', 'gnutls')}
+        for target, directory, archive, binary_name in LIBRARIES:
+            prefix = work / 'dist' / directory / platform / 'thin' / arch
+            thin = prefix / 'lib' / archive
+            thin_row, thin_copy = snapshot_regular(thin, work, scratch, platform + '-' + arch + '-' + target + '-source.a')
+            if target == 'Libsmbclient' and (thin_row['bytes'], thin_row['sha256']) != SMB_PINS[platform + '/' + arch]:
+                fail('retained Samba archive differs from the approved wrapper')
+            thin_headers = check_thin_headers(target, prefix, work)
+            framework = package / 'artifacts' / (target + '.xcframework') / slice_name / (binary_name + '.framework')
+            binary, layout = framework_layout(framework, binary_name, slice_name, package)
+            fat_row, fat_copy = snapshot_regular(binary, package, scratch, platform + '-' + arch + '-' + target + '-package.a')
+            fat_headers = check_headers(target, framework / 'Headers', package)
+            headers_match = header_correspondence(target, work, package, prefix, framework, slice_name,
+                                                  thin_headers, fat_headers)
+            # Stable basenames keep archive-member headings deterministic on
+            # reader reread; random private staging paths never enter stdout.
+            arches_raw = run_reader([lipo, '-archs', fat_copy.name], scratch)
+            if sorted(arches_raw.split()) != slices[slice_name]:
+                fail('packaged architecture set differs')
+            # BaseBuild uses lipo -create even for one architecture. FAT wrappers
+            # always need thinning; only an actual one-arch AR can copy directly.
+            with fat_copy.open('rb') as container:
+                kind = archive_kind(container.read(8), fat_row['bytes'], len(slices[slice_name]))
+            extracted = None
+            if kind == 'ar':
+                correspondence = {'bytes': fat_row['bytes'], 'sha256': fat_row['sha256']}
+            else:
+                extracted = Path(scratch) / (platform + '-' + arch + '-' + target + '.a')
+                run_reader([lipo, fat_copy.name, '-thin', arch, '-output', extracted.name], scratch)
+                extracted_row = regular(extracted, Path(scratch), MAX_ARCHIVE)
+                correspondence = {'bytes': extracted_row['bytes'], 'sha256': extracted_row['sha256']}
+            if correspondence != {'bytes': thin_row['bytes'], 'sha256': thin_row['sha256']}:
+                fail('packaged archive does not correspond to the current thin build')
+            defined_raw = run_reader([nm, '-arch', arch, '-g', '-U', '-j', thin_copy.name], scratch)
+            undefined_raw = run_reader([nm, '-arch', arch, '-u', '-j', thin_copy.name], scratch)
+            reader_budget += sum(len(json.dumps(reader_record(value), ensure_ascii=True).encode('ascii'))
+                                 for value in (arches_raw, defined_raw, undefined_raw))
+            if reader_budget > MAX_READER_JSON:
+                fail('aggregate native reader evidence exceeds bound')
+            observations[target] = {'defined': normalize_symbols(defined_raw), 'undefined': normalize_symbols(undefined_raw)}
+            library_rows[target] = {
+                'version': VERSIONS[target], 'thin': thin_row, 'thinHeaders': thin_headers,
+                'packaged': fat_row, 'packagedHeaders': fat_headers, 'correspondence': correspondence,
+                'frameworkLayout': layout,
+                'headerCorrespondence': headers_match,
+                'architectures': reader_record(arches_raw),
+                'defined': reader_record(defined_raw), 'undefined': reader_record(undefined_raw),
+            }
+            thin_copy.unlink()
+            fat_copy.unlink()
+            if extracted is not None:
+                extracted.unlink()
+        rows.append({'platform': platform, 'arch': arch, 'slice': slice_name,
+                     'libraries': library_rows, 'builds': builds, **validate_symbols(observations)})
+    result = {'schemaVersion': SCHEMA, 'profile': PROFILE, 'work': str(work), 'packagePolicy': PACKAGE_POLICY,
+            'inlineBodyPolicy': INLINE_BODY_POLICY,
+            'versions': VERSIONS, 'sourcePins': SOURCES, 'tools': tools, 'packageManifest': manifest,
+            'xcframeworkInfo': containers, 'releaseSourceBoundary': source_boundary,
+            'rows': rows, 'acceptance': 'ARCHIVE_AND_PUBLIC_SYMBOL_CORRESPONDENCE_ONLY',
+            'openGates': list(OPEN_GATES)}
+    validate_receipt_caps(result)
+    return result
+
+
+def validate_receipt_caps(value):
+    def reader_bytes(item):
+        if isinstance(item, dict):
+            if 'text' in item:
+                if (set(item) != {'bytes', 'sha256', 'text'} or type(item['text']) is not str
+                        or type(item['bytes']) is not int or not 0 <= item['bytes'] <= MAX_READER):
+                    fail('reader evidence row shape differs')
+                raw = item['text'].encode('utf-8')
+                if len(raw) != item['bytes'] or digest_bytes(raw) != item['sha256']:
+                    fail('reader evidence bytes/hash differ')
+                return len(json.dumps(item, sort_keys=True).encode('utf-8'))
+            return sum(reader_bytes(child) for child in item.values())
+        if isinstance(item, list):
+            return sum(reader_bytes(child) for child in item)
+        return 0
+    def metadata(item):
+        if isinstance(item, dict):
+            return {key: metadata(child) for key, child in item.items() if key not in ('bodyBase64', 'text')}
+        if isinstance(item, list):
+            return [metadata(child) for child in item]
+        return item
+    if reader_bytes(value) > MAX_READER_JSON:
+        fail('aggregate native reader evidence exceeds cap')
+    if len(json.dumps(metadata(value), indent=2, sort_keys=True).encode('utf-8')) > MAX_METADATA_JSON:
+        fail('receipt metadata exceeds cap')
+    if len((json.dumps(value, indent=2, sort_keys=True) + '\n').encode('utf-8')) > MAX_RECEIPT:
+        fail('receipt exceeds cap')
+
+
+def strict_json(data):
+    if isinstance(data, bytes):
+        data = data.decode('utf-8', errors='strict')
+    def unique(pairs):
+        result = {}
+        for key, value in pairs:
+            if key in result:
+                fail('duplicate receipt field')
+            result[key] = value
+        return result
+    return json.loads(data, object_pairs_hook=unique,
+                      parse_constant=lambda value: fail('non-finite receipt number'))
+
+
+def exact_equal(left, right):
+    if type(left) is not type(right):
+        return False
+    if isinstance(left, dict):
+        return set(left) == set(right) and all(exact_equal(left[key], right[key]) for key in left)
+    if isinstance(left, list):
+        return len(left) == len(right) and all(exact_equal(a, b) for a, b in zip(left, right))
+    return left == right
+
+
+def validate_receipt(receipt, observed):
+    """Fresh IO is supplied by capture_evidence, never derived from the receipt."""
+    if not isinstance(receipt, dict) or set(receipt) != set(observed):
+        fail('receipt field set differs')
+    if (receipt.get('schemaVersion') != SCHEMA or receipt.get('profile') != PROFILE
+            or receipt.get('versions') != VERSIONS or receipt.get('sourcePins') != SOURCES
+            or receipt.get('packagePolicy') != PACKAGE_POLICY or receipt.get('inlineBodyPolicy') != INLINE_BODY_POLICY):
+        fail('receipt identity differs')
+    expected_matrix = [(platform, arch, slice_name) for platform, arch, slice_name in MATRIX]
+    rows = receipt.get('rows')
+    if (not isinstance(rows, list) or len(rows) != len(MATRIX)
+            or [(row.get('platform'), row.get('arch'), row.get('slice')) for row in rows if isinstance(row, dict)] != expected_matrix):
+        fail('receipt slice matrix differs')
+    if not exact_equal(receipt, observed):
+        fail('receipt does not match current input bytes and native reader observations')
+    validate_inline_bodies(receipt)
+    validate_receipt_caps(receipt)
+
+
+def write_receipt(path, value, work):
+    if path.exists() or path.is_symlink():
+        fail('refusing to overwrite an existing receipt')
+    if path.parent.resolve() != path.parent or work not in path.parent.parents:
+        fail('linked or escaping receipt directory')
+    data = (json.dumps(value, indent=2, sort_keys=True) + '\n').encode()
+    if len(data) > MAX_RECEIPT:
+        fail('receipt exceeds bound')
+    descriptor = os.open(path, os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW, 0o600)
+    with os.fdopen(descriptor, 'wb') as output:
+        output.write(data)
+
+
+def main():
+    parser = argparse.ArgumentParser(description=__doc__)
+    parser.add_argument('mode', choices=('capture', 'verify'))
+    parser.add_argument('work')
+    parser.add_argument('package')
+    parser.add_argument('--dependency-profile', required=True, choices=(PROFILE,))
+    args = parser.parse_args()
+    work, package = contained_root(args.work, 'WORK'), contained_root(args.package, 'PACKAGE')
+    receipt = work / RECEIPT_RELATIVE
+    receipt.parent.mkdir(parents=True, exist_ok=True)
+    if receipt.parent.resolve() != receipt.parent:
+        fail('linked receipt parent')
+    # Staging stays within WORK; no VortX data or native reader output in /tmp.
+    with tempfile.TemporaryDirectory(prefix='.reader-', dir=receipt.parent) as scratch:
+        observed = capture_evidence(work, package, scratch)
+    if args.mode == 'capture':
+        write_receipt(receipt, observed, work)
+    else:
+        _, body = read_verified(receipt, work, MAX_RECEIPT)
+        validate_receipt(strict_json(body), observed)
+    print('PASS crypto-chain archive/public-symbol correspondence; native SMB/runtime gates OPEN')
+
+
+if __name__ == '__main__':
+    try:
+        main()
+    except (ValueError, OSError, subprocess.SubprocessError) as error:
+        raise SystemExit(str(error))
