+def recipe_contract(work, library, platform, arch, sdk_tools):
+    """Exact source recipe fields, independent of the untrusted build record."""
+    dist = work / 'dist'
+    prefix = dist / library / platform / 'thin' / arch
+    scratch = dist / library / platform / 'scratch' / arch
+    _, target_os, minimum, host_os = PLATFORMS[platform]
+    target_cpu = 'x86_64' if arch == 'x86_64' else 'arm64'
+    host = target_cpu + '-' + host_os + '-darwin'
+    cflags = ['-arch', arch, '-isysroot', sdk_tools['sdkRoot'], '-target', target_cpu + '-apple-' + target_os, minimum]
+    if platform in ('tvos', 'tvsimulator'):
+        cflags.append('-DHAVE_FORK=0')
+    dependencies = () if library == 'gmp' else ('gmp',) if library == 'nettle' else ('gmp', 'nettle')
+    for dependency in dependencies:
+        cflags.append('-I' + str(dist / dependency / platform / 'thin' / arch / 'include'))
+    ldflags = ['-lc++', '-arch', arch, '-isysroot', sdk_tools['sdkRoot'], '-target', target_cpu + '-apple-' + target_os, minimum]
+    for dependency in dependencies:
+        ldflags.append('-L' + str(dist / dependency / platform / 'thin' / arch / 'lib'))
+        if library != 'gnutls':
+            ldflags.append('-l' + dependency)
+    flags = ' '.join(cflags)
+    environment = {'LC_CTYPE': 'C', 'CC': '/usr/bin/clang', 'CXX': '/usr/bin/clang++',
+                   'CURRENT_ARCH': arch, 'CFLAGS': flags, 'CPPFLAGS': flags,
+                   'CXXFLAGS': flags, 'ASMFLAGS': flags, 'LDFLAGS': ' '.join(ldflags),
+                   'PKG_CONFIG_LIBDIR': ':'.join(str(dist / name / platform / 'thin' / arch / 'lib/pkgconfig') for name in PKG_LIBRARIES) + ':' + str(scratch / 'vortx-sdk-pkgconfig'),
+                   'PKG_CONFIG_PATH': '', 'PATH': DEFAULT_PATH,
+                   'MAKEFLAGS': '-j1', 'CMAKE_BUILD_PARALLEL_LEVEL': '1', 'CARGO_BUILD_JOBS': '1',
+                   'AR': sdk_tools['ar']['selectedPath'], 'RANLIB': sdk_tools['ranlib']['selectedPath'],
+                   'CC_FOR_BUILD': '/usr/bin/clang'}
+    if library == 'gmp':
+        environment['ABI'] = '64'
+    if library == 'gnutls':
+        gmp = str(dist / 'gmp' / platform / 'thin' / arch)
+        nettle = str(dist / 'nettle' / platform / 'thin' / arch)
+        environment.update(GMP_CFLAGS='-I' + gmp + '/include', GMP_LIBS='-L' + gmp + '/lib -lgmp',
+                           NETTLE_CFLAGS='-I' + nettle + '/include', NETTLE_LIBS='-L' + nettle + '/lib -lnettle',
+                           HOGWEED_CFLAGS='-I' + nettle + '/include',
+                           HOGWEED_LIBS='-L' + nettle + '/lib -lhogweed -lnettle -L' + gmp + '/lib -lgmp')
+    return {'schema': 1, 'library': library, 'selector': SELECTORS[library],
+            'sourceDirectory': str(dist / (library + '-' + SELECTORS[library])),
+            'platform': platform, 'arch': arch,
+            'configureArguments': ['--prefix=' + str(prefix), *CONFIGURE_FLAGS[library], '--host=' + host],
+            'makeArguments': list(MAKE_ARGUMENTS),
+            'environment': environment, 'buildDirectory': str(scratch), 'prefix': str(prefix),
+            'compiled': True, 'installed': True}
+
