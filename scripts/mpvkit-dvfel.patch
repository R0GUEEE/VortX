+def contained_root(value, label):
+    path = Path(value)
+    if not path.is_absolute() or path.resolve() != path:
+        fail(label + ' must be an absolute, unlinked path')
+    for ancestor in (path, *path.parents):
+        if ancestor.is_symlink():
+            fail(label + ' has a linked ancestor')
+    if not path.is_dir():
+        fail(label + ' is not a directory')
+    return path
+
+
+def stable_identity(row):
+    return (row.st_dev, row.st_ino, row.st_mode, row.st_nlink, row.st_size,
+            row.st_mtime_ns, row.st_ctime_ns)
+
+
+def bounded_digest(stream, maximum):
+    count, h = 0, hashlib.sha256()
+    while True:
+        block = stream.read(min(1024 * 1024, maximum - count + 1))
+        if not block:
+            return count, h.hexdigest()
+        count += len(block)
+        if count > maximum:
+            fail('input grew beyond its continuous hash bound')
+        h.update(block)
+
+
+def archive_kind(header, total_bytes, architecture_count):
+    """Dispatch on the container, never infer thin AR from one architecture."""
+    if len(header) != 8 or total_bytes < 8:
+        fail('unknown or truncated archive container magic')
+    if header == b'!<arch>\n':
+        if architecture_count != 1:
+            fail('an AR container requires exactly one declared architecture')
+        return 'ar'
+    fat = {b'\xca\xfe\xba\xbe': ('big', 20), b'\xbe\xba\xfe\xca': ('little', 20),
+           b'\xca\xfe\xba\xbf': ('big', 32), b'\xbf\xba\xfe\xca': ('little', 32)}
+    if len(header) != 8 or header[:4] not in fat:
+        fail('unknown or truncated archive container magic')
+    byteorder, entry_size = fat[header[:4]]
+    count = int.from_bytes(header[4:8], byteorder)
+    if count != architecture_count or not 1 <= count <= len(MATRIX):
+        fail('FAT architecture count differs from the required slice')
+    if total_bytes < 8 + entry_size * count:
+        fail('truncated FAT architecture table')
+    return 'fat'
+
+
+def regular(path, root, maximum):
+    """No arbitrary filesystem aliases, links, devices, or mutable open handles."""
+    if not path.is_absolute() or root not in path.parents:
+        fail('file is outside its declared root')
+    relative = path.relative_to(root)
+    current = root
+    for part in relative.parts:
+        current = current / part
+        if current.is_symlink():
+            fail('unexpected symlink: ' + str(relative))
+    before = path.lstat()
+    if (not stat.S_ISREG(before.st_mode) or before.st_nlink != 1
+            or not 0 < before.st_size <= maximum):
+        fail('not one bounded regular file: ' + str(relative))
+    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        opened = os.fstat(descriptor)
+        if stable_identity(opened) != stable_identity(before):
+            fail('file changed before reading: ' + str(relative))
+        with os.fdopen(descriptor, 'rb', closefd=False) as stream:
+            count, sha = bounded_digest(stream, maximum)
+        after = os.fstat(descriptor)
+        final = path.lstat()
+        if (count != opened.st_size or stable_identity(opened) != stable_identity(after)
+                or stable_identity(after) != stable_identity(final)):
+            fail('file changed while reading: ' + str(relative))
+        return {'path': relative.as_posix(), 'bytes': after.st_size, 'sha256': sha}
+    finally:
+        os.close(descriptor)
+
+
+def text_file(path, root):
+    row, body = read_verified(path, root, MAX_HEADER)
+    return row, body.decode('utf-8', errors='strict')
+
+
+def read_verified(path, root, maximum):
+    row = regular(path, root, maximum)
+    before = path.lstat()
+    if (not stat.S_ISREG(before.st_mode) or before.st_nlink != 1
+            or before.st_size != row['bytes']):
+        fail('input changed before bounded body read')
+    descriptor = os.open(path, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    with os.fdopen(descriptor, 'rb') as stream:
+        opened = os.fstat(stream.fileno())
+        if stable_identity(opened) != stable_identity(before):
+            fail('input changed to a non-regular file')
+        body = stream.read(maximum + 1)
+        after = os.fstat(stream.fileno())
+    if (len(body) > maximum or len(body) != row['bytes'] or digest_bytes(body) != row['sha256']
+            or stable_identity(opened) != stable_identity(after)
+            or stable_identity(after) != stable_identity(path.lstat())):
+        fail('input changed while reading bounded body')
+    return row, body
+
+
+def macro(text, name):
+    matches = re.findall(r'^\s*#\s*define\s+' + re.escape(name) + r'\s+([0-9]+)\s*(?:/\*.*\*/)?\s*$', text, re.M)
+    if len(matches) != 1:
+        fail('expected one numeric macro ' + name)
+    return int(matches[0])
+
+
+def check_headers(target, headers, root, platform=None, arch=None):
+    """Check selected public versions; returned hashes bind every checked header."""
+    if target == 'gmp':
+        row, content = text_file(headers / 'gmp.h', root)
+        values = tuple(macro(content, key) for key in ('__GNU_MP_VERSION', '__GNU_MP_VERSION_MINOR', '__GNU_MP_VERSION_PATCHLEVEL'))
+        if values != (6, 3, 0) or (macro(content, 'GMP_LIMB_BITS'), macro(content, 'GMP_NAIL_BITS')) != (64, 0):
+            fail('mixed GMP public header version')
+        return [row]
+    if target in ('nettle', 'hogweed'):
+        # BaseBuild copies include/nettle directly for nettle; hogweed falls back
+        # to all of include because there is no include/hogweed directory.
+        candidate = headers / 'version.h' if target == 'nettle' else headers / 'nettle/version.h'
+        row, content = text_file(candidate, root)
+        if tuple(macro(content, key) for key in ('NETTLE_VERSION_MAJOR', 'NETTLE_VERSION_MINOR', 'NETTLE_USE_MINI_GMP')) != (4, 0, 0):
+            fail('mixed Nettle version or mini-GMP backend')
+        return [row]
+    if target == 'gnutls':
+        row, content = text_file(headers / 'gnutls.h', root)
+        if tuple(macro(content, key) for key in ('GNUTLS_VERSION_MAJOR', 'GNUTLS_VERSION_MINOR', 'GNUTLS_VERSION_PATCH')) != (3, 8, 13):
+            fail('mixed GnuTLS public header version')
+        if not re.search(r'^\s*#\s*define\s+GNUTLS_VERSION\s+"3\.8\.13"\s*$', content, re.M):
+            fail('GnuTLS release string differs')
+        return [row]
+    if target == 'Libsmbclient':
+        rows = []
+        # The retained wrapper's framework includes include/samba-4.0/.
+        for name, (size, expected) in SMB_HEADERS.items():
+            row = regular(headers / 'samba-4.0' / name, root, MAX_HEADER)
+            if (row['bytes'], row['sha256']) != (size, expected):
+                fail('retained Samba public header identity differs')
+            rows.append(row)
+        return rows
+    fail('unrecognized library')
+
+
+def check_thin_headers(target, prefix, root):
+    headers = prefix / 'include'
+    if target == 'nettle':
+        headers = headers / 'nettle'
+    elif target == 'gnutls':
+        headers = headers / 'gnutls'
+    return check_headers(target, headers, root)
+
