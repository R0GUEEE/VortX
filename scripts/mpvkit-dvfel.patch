+def normalize_symbols(raw):
+    symbols = set()
+    for line in raw.splitlines():
+        value = line.strip()
+        if not value or value.endswith(':'):
+            continue
+        if not re.fullmatch(r'[A-Za-z_.$][A-Za-z0-9_.$]*', value):
+            fail('unrecognized nm -j row')
+        # One Mach-O ABI underscore, not every leading underscore (GMP uses two).
+        symbols.add(value[1:] if value.startswith('_') else value)
+    return symbols
+
+
+def validate_symbols(observations):
+    if set(observations) != {item[0] for item in LIBRARIES}:
+        fail('symbol library set differs')
+    for target, required in REQUIRED.items():
+        if not required <= observations[target]['defined']:
+            fail('required defined public symbol missing from ' + target)
+    consumer = observations['Libsmbclient']
+    def crypto_helper(name):
+        return name.startswith(('nettle_', '_nettle_', 'hogweed_', '__gmp',
+                                'gmp_', 'mpz_', 'mpn_', 'mpq_', 'mpf_'))
+    # Nettle 4 retains some symbol names while changing their C signatures.
+    # The approved retention boundary is the public GnuTLS ABI only; a direct
+    # helper import or a statically embedded old provider requires a rebuild.
+    if any(crypto_helper(name) for name in consumer['undefined']):
+        fail('retained Samba directly imports a crypto-helper ABI; rebuild required')
+    if any(name.startswith('_gnutls_') for name in consumer['undefined']):
+        fail('retained Samba imports a private GnuTLS ABI; rebuild required')
+    if any(name.startswith(('gnutls_', '_gnutls_')) or crypto_helper(name)
+           for name in consumer['defined']):
+        fail('retained Samba embeds crypto provider symbols; rebuild required')
+    imports = {name for name in consumer['undefined'] if name.startswith('gnutls_')} - consumer['defined']
+    if not imports:
+        fail('retained Samba has no observed public GnuTLS imports')
+    unresolved = imports - observations['gnutls']['defined']
+    if unresolved:
+        fail('new GnuTLS does not define retained Samba imports: ' + ', '.join(sorted(unresolved)))
+    helper_edges = {}
+    for target in ('nettle', 'hogweed', 'gnutls'):
+        required = {name for name in observations[target]['undefined'] if crypto_helper(name)} - observations[target]['defined']
+        providers = set().union(*(observations[name]['defined'] for name in ('gmp', 'nettle', 'hogweed') if name != target))
+        if required - providers:
+            fail(target + ' crypto-helper imports are unresolved by the selected closure')
+        helper_edges[target] = sorted(required)
+    if not helper_edges['gnutls']:
+        fail('new GnuTLS has no observed crypto-helper linkage')
+    return {'sambaGnuTLSImports': sorted(imports), 'helperImports': helper_edges}
+
+
+def run_reader(arguments, scratch):
+    """Run only the selected native reader later; this module never runs on import."""
+    with tempfile.TemporaryFile(dir=scratch) as output, tempfile.TemporaryFile(dir=scratch) as error:
+        process = subprocess.Popen(arguments, stdin=subprocess.DEVNULL, stdout=output, stderr=error,
+                                   cwd=scratch, env={'PATH': '/usr/bin:/bin:/usr/sbin:/sbin', 'LC_ALL': 'C'})
+        try:
+            code = process.wait(timeout=60)
+        except BaseException:
+            process.kill()
+            process.wait()
+            raise
+        if output.tell() > MAX_READER or error.tell() > MAX_READER:
+            fail('reader output exceeds bound')
+        output.seek(0)
+        error.seek(0)
+        data, diagnostic = output.read(), error.read()
+    if code != 0:
+        fail('reader failed: ' + str(arguments[0]) + ': ' + diagnostic.decode('utf-8', errors='replace')[:1024])
+    return data.decode('utf-8', errors='strict')
+
+
+def reader_record(text):
+    data = text.encode('utf-8')
+    return {'bytes': len(data), 'sha256': digest_bytes(data), 'text': text}
+
+
+def tool_identity(path):
+    resolved = Path(path).resolve()
+    # Xcode command-line tool entry points may be links. Resolve once and pin
+    # the actual regular reader body; never accept a supplied shell command.
+    if not resolved.is_absolute() or not resolved.is_file():
+        fail('native reader is unavailable')
+    # Apple installs some selected tool bodies with multiple hardlinks. This
+    # exception applies only here, never to archive/configuration input files.
+    before = resolved.lstat()
+    if not stat.S_ISREG(before.st_mode) or before.st_nlink < 1 or not 0 < before.st_size <= MAX_ARCHIVE:
+        fail('native tool body is not a bounded regular file')
+    descriptor = os.open(resolved, os.O_RDONLY | os.O_NOFOLLOW | os.O_NONBLOCK)
+    try:
+        opened = os.fstat(descriptor)
+        if stable_identity(before) != stable_identity(opened):
+            fail('native tool changed before reading')
+        with os.fdopen(descriptor, 'rb', closefd=False) as stream:
+            count, sha = bounded_digest(stream, MAX_ARCHIVE)
+        after = os.fstat(descriptor)
+        if (count != opened.st_size or stable_identity(opened) != stable_identity(after)
+                or stable_identity(after) != stable_identity(resolved.lstat())):
+            fail('native tool changed while reading')
+        return {'resolvedPath': str(resolved), 'path': resolved.name,
+                'bytes': after.st_size, 'sha256': sha}
+    finally:
+        os.close(descriptor)
+
+
+def resolved_tools(scratch):
+    xcrun = '/usr/bin/xcrun'
+    tools = {'xcrun': tool_identity(xcrun), 'xcodebuild': tool_identity('/usr/bin/xcodebuild')}
+    for name in ('lipo', 'nm'):
+        value = run_reader([xcrun, '--find', name], scratch).strip()
+        if not value.startswith('/') or '\n' in value:
+            fail('xcrun did not return one absolute reader')
+        tools[name] = tool_identity(value)
+    tools['toolchainVersion'] = reader_record(run_reader(['/usr/bin/xcodebuild', '-version'], scratch))
+    tools['platforms'] = {}
+    for platform, (sdk, _, _, _) in PLATFORMS.items():
+        sdk_root = run_reader([xcrun, '--sdk', sdk, '--show-sdk-path'], scratch).strip()
+        if not sdk_root.startswith('/') or '\n' in sdk_root or not sdk_root.endswith('.sdk'):
+            fail('xcrun did not return one selected SDK root')
+        row = {'sdkRoot': sdk_root, 'resolvedSDKRoot': str(Path(sdk_root).resolve())}
+        for name in ('ar', 'ranlib'):
+            path = run_reader([xcrun, '--sdk', sdk, '--find', name], scratch).strip()
+            if not path.startswith('/') or '\n' in path:
+                fail('xcrun did not return one target archive tool')
+            row[name] = {'selectedPath': path, **tool_identity(path)}
+        tools['platforms'][platform] = row
+    return tools
+
