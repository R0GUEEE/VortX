{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "VortX",
  "version": "0.3.0",
  "identifier": "com.stremiox.desktop",
  "build": {
    "beforeDevCommand": "bash scripts/fetch-server-deps.sh && npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bash scripts/fetch-server-deps.sh && npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "VortX",
        "width": 1280,
        "height": 800,
        "minWidth": 960,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "script-src-attr": "'none'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:11470",
        "img-src": "'self' http: https:",
        "media-src": "'self' http: https:",
        "font-src": "'self'",
        "frame-src": "https://www.youtube-nocookie.com/embed/",
        "worker-src": "'none'",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      },
      "devCsp": {
        "default-src": "'none'",
        "script-src": "'self'",
        "script-src-attr": "'none'",
        "style-src": "'self' 'unsafe-inline'",
        "style-src-attr": "'unsafe-inline'",
        "connect-src": "'self' ipc: http://ipc.localhost http://127.0.0.1:11470 http://localhost:1420 ws://localhost:1420",
        "img-src": "'self' http: https:",
        "media-src": "'self' http: https:",
        "font-src": "'self'",
        "frame-src": "https://www.youtube-nocookie.com/embed/",
        "worker-src": "'self' blob:",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'"
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage", "nsis", "app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "resources/server.cjs": "server.cjs",
      "resources/node-*": ""
    }
  }
}
